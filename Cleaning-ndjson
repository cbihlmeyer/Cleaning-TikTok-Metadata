    # Apply the same common normalization pipeline you used for desc/on-screen
    transcript_clean = .trans %>%
      normalize_text_common(
        do_html_unescape   = TRUE,
        do_strip_emojis    = TRUE,
        do_strip_zw        = TRUE,
        do_replace_urls    = TRUE,   # matches  desc/on-screen behavior
        do_strip_hashtags  = TRUE,
        do_strip_mentions  = TRUE,
        do_restrict_punct  = TRUE,
        do_lower           = TRUE,
        do_squish          = TRUE
      )
  ) %>%
  select(-.trans)

## Safety check: cleaned post description
cat("Safety check: cleaned transcript with item ID and cleaned on-screen text")
meta %>% select(item_id, transcript_clean, on_screen_text_clean) %>% head(15)
```
## Near-Match Duplicate Detection
#### First-pass duplicate detection was handled in Zeeschuimer's software, omitting any on-screeen duplicates during scraping.
Near-match duplicates will be detected on the criteria of exact match in all four fields: author handle, description, transcription, on-screen text match. Videos meeting this criteria will be omitted.
```{r,  echo=FALSE, warning=FALSE, message=FALSE}
## --- Exact-match duplicate detection  ---
## Build a combined key from the three fields
key <- with(meta, paste(author_handle, desc_clean, transcript_clean, on_screen_text_clean, sep = "||"))
## Flag rows that have any duplicates (either earlier or later in the data)
dup_any <- duplicated(key) | duplicated(key, fromLast = TRUE)
## See how many
sum(dup_any) # author_handle, desc, trans
## View just the duplicate groups (both originals and repeats)
# NOTE: Duplicate is counted if all fields are "NA"
cat("Two videos are near-matches; the first occurence is kept")
dups <- meta[dup_any, ]

## --- Drop duplicates, keep first occurrence per combination ---
keep_first <- !duplicated(key)
meta <- meta[keep_first, ]

## --- Final checks for duplicates  ---
